#general
TZ=America/Sao_Paulo

#postgress
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=<POSTGRES_DB>
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=<POSTGRES_DB>;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>

#next
NEXT_PUBLIC_API_URL=http://localhost:5000

#TMDB
TMDB_API_KEY=<TMDB_API_KEY>

#WAHA
WAHA_URL=http://waha:3000
WAHA_DASHBOARD_USERNAME=<WAHA_DASHBOARD_USERNAME>
WAHA_DASHBOARD_PASSWORD=<WAHA_DASHBOARD_PASSWORD>
WAHA_API_KEY=<WAHA_API_KEY>
WAHA_CHAT_ID=<WAHA_CHAT_ID>@g.us
WHATSAPP_SWAGGER_USERNAME=<WHATSAPP_SWAGGER_USERNAME>
WHATSAPP_SWAGGER_PASSWORD=<WHATSAPP_SWAGGER_PASSWORD>
WHATSAPP_HOOK_URL=http://backend:5000/api/whatsapp/webhooks
WHATSAPP_HOOK_EVENTS=message,poll.vote
